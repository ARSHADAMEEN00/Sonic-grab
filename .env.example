# Optional local development configuration (never commit real secrets)
# Public Jamendo Client ID (https://devportal.jamendo.com/)

# Optional Apple Music Developer Token (JWT) - never embed your private .p8 signing key here
VITE_APPLE_MUSIC_TOKEN=

# Optional Spotify temporary user OAuth token (metadata only)
VITE_SPOTIFY_ACCESS_TOKEN=

# Optional SoundCloud public client_id if you have an authorised app
VITE_SOUNDCLOUD_CLIENT_ID=
